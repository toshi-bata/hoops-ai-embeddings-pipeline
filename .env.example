# Copy this file to .env (gitignored -- it holds a license key, not
# something to commit) in this repo's root, and fill in the values for your
# machine. This ONE file is read by everything in this repo:
#   - every bench_step*.py script and run_pipeline.py, via bench_common.py's
#     load_dotenv() (for HOOPS_AI_LICENSE and HOOPS_AI_CKPT)
#   - run_benchmark.ps1 / preflight.ps1 / run_local_sweep.ps1, via
#     resolve_local_env.ps1 (for CPU_PY / GPU_PY / HOOPS_AI_CKPT)
# Search order (first found wins): ./.env, ../.env, ../CPU1.1/.env,
# ../GPU1.1/.env -- so this can also live one level up, next to your SDK's
# CPU1.1/GPU1.1 install folders, if you prefer to share one .env across
# multiple repos/tools.

# Required for every script.
HOOPS_AI_LICENSE='<your key>'

# Only needed if bench_step2/3's automatic search (*/packages/trained_ml_models/
# under the SDK root) doesn't find it -- e.g. because this repo isn't nested
# inside your SDK install directory. Overrides the auto-search when set.
HOOPS_AI_CKPT='C:\SDK\HOOPS_AI\V1.1\packages\trained_ml_models\ts3d_2M_hoops_embeddings_SIGNAL-preview.ckpt'

# Only needed by run_benchmark.ps1 / preflight.ps1 / run_local_sweep.ps1
# (Windows). HOOPS AI SDK install folder names vary by machine (e.g. "V1.1"
# on one box, "CPU1.1" on another after a rename) -- set these once here
# instead of hunting down every hardcoded default.
CPU_PY='C:\SDK\HOOPS_AI\V1.1\.venv\Scripts\python.exe'
GPU_PY='C:\SDK\HOOPS_AI\GPU1.1\.venv\Scripts\python.exe'
